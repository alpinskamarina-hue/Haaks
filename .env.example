# Supabase project (Settings -> API). Choose an EU region when creating the project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service account for the public pages (passport, quote, invoice): an auth user
# with app_metadata.role = "haaks_server". Never expose to the browser.
HAAKS_SERVER_EMAIL=
HAAKS_SERVER_PASSWORD=

# Claude API key (console.anthropic.com). Without it documents are stored but not read automatically.
ANTHROPIC_API_KEY=
# Optional: model used to read documents.
CLAUDE_MODEL=claude-opus-5-5

# Public address of the site, used in the passport link and QR code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
